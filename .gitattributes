# Normalise text files to LF in the repository, whatever the OS.
* text=auto eol=lf

# Windows helper scripts keep CRLF so they run in PowerShell/cmd.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary

# Keep generated JSONL fixtures diff-friendly.
*.jsonl text eol=lf
