    {
      "name": "03 · Trigger and idempotency",
      "item": [
        {
          "name": "Simulate a 62 mm storm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('not a replay', () => pm.expect(b.duplicate).to.eql(false));",
                  "pm.test('some workers approved', () => pm.expect(b.counts.APPROVE).to.be.above(0));",
                  "pm.test('mock payout batches', () => pm.expect(b.payout_result.mock).to.eql(true));",
                  "pm.environment.set('eventId', b.event.id);",
                  "pm.environment.set('eventKey', b.event.event_key);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Operator-Key", "value": "{{operatorKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zone\": \"hyderabad-central\",\n  \"rainfall_mm\": 62,\n  \"days\": 1,\n  \"event_key\": \"qa:storm:{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "simulate"]
            }
          }
        },
