    {
      "name": "01 · Policy and enrollment",
      "item": [
        {
          "name": "Parse a policy sentence",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('parser produced a policy', () => pm.expect(b.ok).to.eql(true));",
                  "pm.test('threshold is 50 mm', () => pm.expect(b.policy.threshold).to.eql(50));",
                  "pm.test('payout is Rs 500', () => pm.expect(b.policy.payout_amount_minor).to.eql(50000));",
                  "pm.test('monthly cap is 3', () => pm.expect(b.policy.max_payouts_per_month).to.eql(3));",
                  "pm.test('waiting period is bounded', () => pm.expect(b.policy.waiting_period_hours).to.be.within(24, 168));",
                  "pm.environment.set('parsedPolicy', JSON.stringify(b.policy));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"If 24-hour rainfall in Hyderabad Central reaches 50 mm, pay me Rs 500, up to 3 days a month.\",\n  \"zone\": \"hyderabad-central\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/parse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "parse"]
            }
          }
        },
        {
          "name": "Enroll a new worker",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('member is active', () => pm.expect(b.member.status).to.eql('active'));",
                  "pm.test('policy is active', () => pm.expect(b.policy.active).to.eql(true));",
                  "pm.test('screening allowed', () => pm.expect(b.screening.recommendation).to.eql('allow'));",
                  "pm.test('receipt is generated', () => pm.expect(b.receipt).to.be.a('string').and.not.empty);",
                  "pm.environment.set('memberId', b.member.id);",
                  "pm.environment.set('policyId', b.policy.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member\": {\n    \"name\": \"QA Runner\",\n    \"email\": \"qa.runner+{{$timestamp}}@example.com\",\n    \"paypal_email\": \"qa.paypal+{{$timestamp}}@example.com\",\n    \"zone\": \"hyderabad-central\",\n    \"device_id\": \"DEV-QA-{{$timestamp}}\",\n    \"signup_ip\": \"198.51.100.77\",\n    \"verified\": true\n  },\n  \"policy\": {{parsedPolicy}},\n  \"source_text\": \"If 24-hour rainfall in Hyderabad Central reaches 50 mm, pay me Rs 500, up to 3 days a month.\"\n}"
            },
            "url": {
