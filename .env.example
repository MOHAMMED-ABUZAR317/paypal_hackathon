# ============================================================================
# RainCheck - example environment file.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value below is safe-by-default for a local demo (mock PayPal, no AI key).
# ============================================================================

# ---------- App ----------
APP_NAME=RainCheck
ENV=development
HOST=127.0.0.1
PORT=8000
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database ----------
# SQLite by default. Point at Postgres for a hosted deployment, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/raincheck
DATABASE_URL=sqlite:///./data/raincheck.db

# Seed a demo pool (members, policies, ledger) on first start.
AUTO_SEED=true
# Number of demo members to create. The pitch uses 10,000; lower it for speed.
SEED_MEMBERS=10000

# ---------- Operator console ----------
# Sent by the frontend as the `X-Operator-Key` header on operator endpoints.
# CHANGE THIS before deploying anything that is publicly reachable.
OPERATOR_API_KEY=dev-operator-key

# ---------- PayPal ----------
# mode = mock  -> no network calls, clearly-labelled simulated money movement
# mode = sandbox -> real PayPal sandbox REST calls (requires credentials below)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the PayPal Developer Dashboard -> your app -> Webhooks.
PAYPAL_WEBHOOK_ID=
# Sandbox business account that *sends* the payouts.
PAYPAL_SENDER_EMAIL=raincheck-sandbox@example.com
# Payout currency. PayPal Payouts does not support INR, so amounts are
# converted from the pool currency (INR) at the rate below.
PAYPAL_PAYOUT_CURRENCY=USD
PAYOUT_INR_PER_USD=83.00

# ---------- AI provider (optional) ----------
# Any OpenAI-compatible chat-completions endpoint works.
# Leave AI_API_KEY empty -> RainCheck uses its deterministic parser and labels
# every response with source="fallback". The demo is fully functional either way.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# ---------- Data feeds ----------
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
# Live rainfall polling interval, in minutes (0 disables the background scheduler).
POLL_INTERVAL_MINUTES=5

# ---------- Optional notifications (Zapier catch hook) ----------
ZAPIER_WEBHOOK_URL=
